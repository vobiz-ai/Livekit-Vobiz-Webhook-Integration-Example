# LiveKit Credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (LLM + TTS)
OPENAI_API_KEY=sk-xxxx

# Deepgram (STT)
DEEPGRAM_API_KEY=xxxx

# Vobiz SIP Trunk
VOBIZ_SIP_DOMAIN=xxxx.sip.vobiz.ai
OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx
DEFAULT_TRANSFER_NUMBER=+15550003333

# CRM Integration (leave empty to skip CRM features)
CRM_BASE_URL=https://api.hubapi.com
CRM_API_KEY=pat-xxxxxxxxxxxxxxxxxxxx

# Webhook (leave empty to skip webhooks)
WEBHOOK_URL=https://your-server.com/webhooks/calls
WEBHOOK_SECRET=your-hmac-secret-here

# Transfer destinations
TRANSFER_SALES=+15550001111
TRANSFER_BILLING=+15550002222
TRANSFER_SUPPORT=+15550003333
